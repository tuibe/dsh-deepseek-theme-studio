{
  "name": "dsh-deepseek-theme-studio",
  "version": "0.1.1",
  "description": "DeepSeek 官网视觉语言的 DSH Web 主题工作台：毛玻璃 / 液化(流体) / 量子化(Q1-Q4) 三类效果，全部参数可调、可持久化、可程序化调用。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "theme",
    "cordis"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1,
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSES",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify": "node scripts/build.mjs --check && node scripts/verify-tokens.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuibe/dsh-deepseek-theme-studio.git"
  },
  "bugs": {
    "url": "https://github.com/tuibe/dsh-deepseek-theme-studio/issues"
  },
  "homepage": "https://github.com/tuibe/dsh-deepseek-theme-studio#readme"
}
